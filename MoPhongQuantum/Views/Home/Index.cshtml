@{
    ViewData["Title"] = "Thiết Lập Mô Phỏng";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<style>
    body {
        background-color: #121212;
        color: #f5f5f5;
    }

    .luxury-container {
        max-width: 650px;
        margin: 50px auto;
        background: #1e1e1e;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 15px 35px rgba(229, 9, 20, 0.15);
        border-top: 4px solid #e50914;
    }

    h2 {
        text-align: center;
        color: #e50914;
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 30px;
    }

    .form-group {
        margin-bottom: 25px;
    }

    label {
        display: block;
        margin-bottom: 10px;
        font-weight: 600;
        color: #ccc;
        letter-spacing: 1px;
        font-size: 14px;
    }

    input[type="number"] {
        width: 100%;
        padding: 14px;
        background: #2a2a2a;
        border: 1px solid #444;
        color: #fff;
        border-radius: 6px;
        box-sizing: border-box;
        transition: 0.3s;
    }

        input[type="number"]:focus {
            border-color: #e50914;
            outline: none;
            box-shadow: 0 0 10px rgba(229, 9, 20, 0.4);
        }

    .btn-submit {
        width: 100%;
        padding: 16px;
        background: linear-gradient(135deg, #e50914, #b20710);
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        font-weight: bold;
        cursor: pointer;
        text-transform: uppercase;
        transition: 0.3s;
        margin-top: 20px;
    }

        .btn-submit:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 20px rgba(229, 9, 20, 0.4);
        }

    #process-container {
        margin-top: 20px;
        padding: 20px;
        background: #151515;
        border-radius: 8px;
        border-left: 3px solid #e50914;
    }

    .process-row {
        display: flex;
        gap: 15px;
        margin-bottom: 15px;
        align-items: center;
    }

        .process-row label {
            margin-bottom: 0;
            min-width: 60px;
            color: #e50914;
            font-weight: bold;
        }
</style>

<div class="luxury-container">
    <h2>Thiết Lập Time Quantum</h2>

    <form id="simForm" action="/Home/TinhToan" method="post">
        <div class="form-group">
            <label>SỐ LƯỢNG TIẾN TRÌNH (N):</label>
            <input type="number" id="soTienTrinh" name="n" placeholder="VD: 3" onchange="generateInputs()" />
        </div>
        <div class="form-group">
            <label>TIME QUANTUM (LÁT CẮT THỜI GIAN):</label>
            <input type="number" id="quantum" name="quantum" placeholder="VD: 2" />
        </div>

        <div id="process-container">
            <p style="color: #666; font-style: italic; margin: 0;">Nhập số lượng tiến trình để thiết lập thông số...</p>
        </div>

        <button type="button" class="btn-submit" onclick="validateAndSubmit()">Khởi Động Mô Phỏng</button>
    </form>
</div>

<script>
    function generateInputs() {
        const n = parseInt(document.getElementById('soTienTrinh').value);
        const container = document.getElementById('process-container');

        if(n > 0 && n <= 10) {
            container.innerHTML = '<div style="display:flex; gap:15px; margin-bottom:15px; color:#aaa; font-size:12px; text-transform:uppercase;"> <div style="flex:1">Arrival Time (TG Đến)</div> <div style="flex:1">Burst Time (TG Chạy)</div> </div>';
            for(let i = 0; i < n; i++) {
                container.innerHTML += `
                    <div class="process-row">
                        <label>P${i+1}:</label>
                        <input type="number" name="at" class="at-input" placeholder="AT" required value="0">
                        <input type="number" name="bt" class="bt-input" placeholder="BT" required>
                    </div>
                `;
            }
        } else {
            container.innerHTML = '<p style="color: #666; font-style: italic; margin: 0;">Số lượng tiến trình hợp lệ từ 1 đến 10.</p>';
        }
    }

    // Hàm bắt lỗi bằng SweetAlert2 phong cách sang chảnh
    function validateAndSubmit() {
        const n = parseInt(document.getElementById('soTienTrinh').value);
        const q = parseInt(document.getElementById('quantum').value);

        if(isNaN(n) || n < 1 || n > 10) {
            Swal.fire({ background: '#1e1e1e', color: '#fff', icon: 'error', title: 'Lỗi Dữ Liệu', text: 'Số lượng tiến trình phải từ 1 đến 10!', confirmButtonColor: '#e50914' });
            return;
        }
        if(isNaN(q) || q < 1) {
            Swal.fire({ background: '#1e1e1e', color: '#fff', icon: 'error', title: 'Lỗi Dữ Liệu', text: 'Time Quantum phải lớn hơn 0!', confirmButtonColor: '#e50914' });
            return;
        }

        let atInputs = document.querySelectorAll('.at-input');
        let btInputs = document.querySelectorAll('.bt-input');
        for(let i = 0; i < atInputs.length; i++) {
            if(atInputs[i].value === '' || btInputs[i].value === '' || parseInt(btInputs[i].value) < 1 || parseInt(atInputs[i].value) < 0) {
                Swal.fire({ background: '#1e1e1e', color: '#fff', icon: 'warning', title: 'Thiếu Dữ Liệu', text: 'Burst Time phải >= 1 và Arrival Time phải >= 0', confirmButtonColor: '#e50914' });
                return;
            }
        }
        document.getElementById('simForm').submit();
    }
</script>