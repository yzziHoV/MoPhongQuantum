@{
    ViewData["Title"] = "Kết Quả Mô Phỏng";
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<style>
    /* KHÔNG CODE CỨNG MÀU NỮA - SỬ DỤNG BIẾN CSS TỪ _LAYOUT */

    .luxury-container {
        max-width: 1000px;
        margin: 40px auto;
        background: var(--bg-card);
        padding: 40px;
        border-radius: 12px;
        border-top: 4px solid var(--primary-red);
        box-shadow: 0 15px 35px var(--shadow-color);
        transition: 0.4s ease;
    }

    h2 {
        text-align: center;
        color: var(--primary-red);
        font-weight: bold;
        text-transform: uppercase;
        letter-spacing: 2px;
        margin-bottom: 25px;
        font-size: 22px;
    }

    /* BỘ ĐIỀU KHIỂN */
    .control-panel {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-bottom: 25px;
    }

    .btn-speed {
        background: var(--bg-main);
        color: var(--text-muted);
        border: 1px solid var(--border-color);
        padding: 10px 20px;
        border-radius: 6px;
        cursor: pointer;
        transition: 0.3s;
        font-weight: 600;
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 13px;
    }

        .btn-speed:hover, .btn-speed.active {
            background: var(--primary-red);
            color: #fff;
            border-color: var(--primary-red);
            box-shadow: 0 5px 15px var(--shadow-color);
        }

    /* BIỂU ĐỒ GANTT */
    .gantt-title {
        font-size: 13px;
        color: var(--text-muted);
        text-transform: uppercase;
        margin-bottom: 15px;
        border-left: 3px solid var(--primary-red);
        padding-left: 10px;
        font-weight: bold;
    }

    .gantt-container {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        background: var(--bg-main);
        padding: 20px;
        border-radius: 8px;
        margin-bottom: 30px;
        min-height: 100px;
        border: 1px solid var(--border-color);
        transition: 0.4s ease;
    }

    /* Khối tiến trình luôn giữ màu đỏ/gradient để nổi bật */
    .gantt-block {
        opacity: 0;
        transform: scale(0.8);
        background: linear-gradient(135deg, var(--primary-red), #91060d);
        color: white;
        padding: 15px;
        margin: 5px;
        border-radius: 6px;
        font-weight: bold;
        text-align: center;
        transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    }

        .gantt-block.show {
            opacity: 1;
            transform: scale(1);
        }

        .gantt-block.idle {
            background: var(--bg-main);
            color: var(--text-muted);
            border: 1px dashed var(--border-color);
            box-shadow: none;
        }

    .gantt-time {
        font-size: 11px;
        color: rgba(255,255,255,0.8);
        margin-top: 5px;
        display: block;
        font-weight: normal;
    }

    .gantt-block.idle .gantt-time {
        color: var(--text-muted);
    }

    /* BẢNG & BIỂU ĐỒ CHART.JS */
    #result-section {
        display: none;
        opacity: 0;
        transition: opacity 1s ease;
    }

    .summary-cards {
        display: flex;
        justify-content: space-between;
        margin-bottom: 30px;
        gap: 20px;
    }

    .card {
        background: var(--bg-main);
        padding: 25px;
        border-radius: 8px;
        flex: 1;
        text-align: center;
        border-bottom: 4px solid var(--primary-red);
        border: 1px solid var(--border-color);
        transition: 0.4s ease;
    }

        .card h4 {
            color: var(--text-muted);
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 10px;
            font-weight: bold;
        }

        .card .value {
            color: var(--text-main);
            font-size: 36px;
            font-weight: 800;
        }

    .chart-box {
        background: var(--bg-main);
        padding: 25px;
        border-radius: 8px;
        margin-bottom: 30px;
        border: 1px solid var(--border-color);
        height: 350px;
        transition: 0.4s ease;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 30px;
        background: var(--bg-main);
        font-size: 14px;
        border: 1px solid var(--border-color);
        border-radius: 8px;
        overflow: hidden;
        transition: 0.4s ease;
    }

    th, td {
        padding: 15px;
        text-align: center;
        border-bottom: 1px solid var(--border-color);
        color: var(--text-main);
    }

    th {
        color: var(--primary-red);
        text-transform: uppercase;
        font-weight: bold;
        border-bottom: 2px solid var(--primary-red);
        background: var(--bg-card);
    }

    /* NÚT CHỨC NĂNG */
    .action-buttons {
        display: flex;
        justify-content: center;
        gap: 15px;
        margin-top: 30px;
        flex-wrap: wrap;
    }

    .btn-action {
        padding: 14px 25px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
        text-transform: uppercase;
        transition: 0.3s;
        border: none;
        font-size: 13px;
        text-decoration: none;
        display: flex;
        align-items: center;
    }

    .btn-back {
        background: transparent;
        color: var(--primary-red);
        border: 2px solid var(--primary-red);
    }

        .btn-back:hover {
            background: var(--primary-red);
            color: #fff;
        }

    .btn-guide {
        background: var(--bg-main);
        color: var(--text-main);
        border: 2px solid var(--border-color);
    }

        .btn-guide:hover {
            border-color: var(--primary-red);
            color: var(--primary-red);
        }

    .btn-download {
        background: #2ecc71;
        color: #111;
        border: 2px solid #2ecc71;
    }

        .btn-download:hover {
            background: #27ae60;
            border-color: #27ae60;
            color: #fff;
        }

    /* HƯỚNG DẪN GIẢI */
    .guide-section {
        display: none;
        background: var(--bg-main);
        padding: 30px;
        border-radius: 8px;
        margin-top: 30px;
        border: 1px solid var(--border-color);
        text-align: left;
        transition: 0.4s ease;
    }

        .guide-section h4 {
            color: var(--text-main);
            margin-top: 30px;
            margin-bottom: 15px;
            font-size: 15px;
            text-transform: uppercase;
            letter-spacing: 1px;
            font-weight: 700;
        }

    .guide-step {
        border-left: 3px solid var(--primary-red);
        padding: 15px;
        background: var(--bg-card);
        margin-bottom: 10px;
        color: var(--text-main);
        font-size: 14px;
        line-height: 1.6;
        border-radius: 0 4px 4px 0;
        border: 1px solid var(--border-color);
        border-left: 3px solid var(--primary-red);
    }

    .guide-formula {
        background: var(--bg-card);
        padding: 15px;
        border-radius: 4px;
        font-family: 'Consolas', monospace;
        color: #2ecc71;
        margin-bottom: 15px;
        border: 1px dashed var(--border-color);
        font-weight: bold;
    }

    .guide-highlight {
        color: var(--text-main);
        font-weight: bold;
    }

        .guide-highlight.red {
            color: var(--primary-red);
        }
</style>

<div class="luxury-container" id="capture-area">
    <h2>Trực Quan Thuật Toán Round Robin</h2>

    <div class="control-panel" data-html2canvas-ignore="true">
        <button class="btn-speed active" id="btn-1x" onclick="playAnimation(1, this)">▶ Bình Thường</button>
        <button class="btn-speed" id="btn-2x" onclick="playAnimation(0.4, this)">⏩ Tua Nhanh (x2)</button>
        <button class="btn-speed" id="btn-skip" onclick="playAnimation(0, this)">⏭ Xem Kết Quả Ngay</button>
    </div>

    <p class="gantt-title">Biểu đồ Gantt điều phối CPU (Quantum = @ViewBag.Quantum ms)</p>
    <div class="gantt-container" id="gantt-chart"></div>

    <div id="result-section">
        @{
            int n = ViewBag.SoTienTrinh;
            var at = ViewBag.ArrivalTimes as List<int>;
            var bt = ViewBag.BurstTimes as List<int>;
            var wt = ViewBag.WaitingTimes as int[];
            var tat = ViewBag.TurnaroundTimes as int[];
            float avgWt = 0, avgTat = 0;
            for (int i = 0; i < n; i++) { avgWt += wt[i]; avgTat += tat[i]; }
            avgWt /= n; avgTat /= n;
        }

        <div class="summary-cards">
            <div class="card"><h4>Thời Gian Chờ TB</h4><div class="value">@avgWt.ToString("0.00") ms</div></div>
            <div class="card"><h4>Thời Gian Hoàn Thành TB</h4><div class="value">@avgTat.ToString("0.00") ms</div></div>
        </div>

        <p class="gantt-title">Phân tích hiệu suất (Waiting Time vs Turnaround Time)</p>
        <div class="chart-box">
            <canvas id="performanceChart"></canvas>
        </div>

        <table>
            <thead><tr><th>Tiến Trình</th><th>Arrival Time</th><th>Burst Time</th><th>Waiting Time</th><th>Turnaround Time</th></tr></thead>
            <tbody>
                @for (int i = 0; i < n; i++)
                {
                    <tr><td style="color:var(--primary-red); font-weight:bold;">P@(i + 1)</td><td>@at[i]</td><td>@bt[i]</td><td>@wt[i]</td><td>@tat[i]</td></tr>
                }
            </tbody>
        </table>

        <div class="action-buttons" data-html2canvas-ignore="true">
            <a href="/Home/Index" class="btn-action btn-back">⬅ THIẾT LẬP BÀI MỚI</a>
            <button class="btn-action btn-guide" onclick="toggleGuide()">📖 HƯỚNG DẪN GIẢI</button>
            <button class="btn-action btn-download" onclick="captureScreen()">📸 TẢI ẢNH KẾT QUẢ</button>
        </div>

        <div id="guide-section" class="guide-section">
            <h3 style="color:var(--primary-red); margin-bottom:10px; text-transform:uppercase; border-bottom:2px solid var(--border-color); padding-bottom:10px; font-size: 18px; font-weight: 800;">📖 Hướng Dẫn Giải Chi Tiết</h3>

            <h4>1. Trình tự cấp phát CPU</h4>
            <div id="guide-steps-container"></div>

            <h4>2. Tính Thời Gian Hoàn Thành (Turnaround Time - TAT)</h4>
            <div class="guide-formula">Công thức: TAT = Thời điểm kết thúc - Arrival Time (Thời gian đến)</div>
            @for (int i = 0; i < n; i++)
            {
                <div class="guide-step">
                    Tiến trình <span class="guide-highlight">P@(i + 1)</span> kết thúc lúc <span class="guide-highlight">@(tat[i] + at[i])ms</span>, đến lúc <span class="guide-highlight">@(at[i])ms</span>
                    <br />➔ TAT = @(tat[i] + at[i]) - @(at[i]) = <span class="guide-highlight red">@(tat[i]) ms</span>
                </div>
            }

            <h4>3. Tính Thời Gian Chờ (Waiting Time - WT)</h4>
            <div class="guide-formula">Công thức: WT = TAT - Burst Time (Thời gian chạy)</div>
            @for (int i = 0; i < n; i++)
            {
                <div class="guide-step">
                    Tiến trình <span class="guide-highlight">P@(i + 1)</span> có TAT = <span class="guide-highlight">@(tat[i])</span>, Burst Time = <span class="guide-highlight">@(bt[i])</span>
                    <br />➔ WT = @(tat[i]) - @(bt[i]) = <span class="guide-highlight red">@(wt[i]) ms</span>
                </div>
            }
        </div>
    </div>
</div>

<script>
    const steps = @Html.Raw(ViewBag.Steps);

    // Đổ dữ liệu C# sang JS để vẽ Chart
    const labels = [];
    const wtData = [];
    const tatData = [];
    @for (int i = 0; i < n; i++)
    {
            @:labels.push("P@(i + 1)");
            @:wtData.push(@wt[i]);
            @:tatData.push(@tat[i]);
    }

    const ganttContainer = document.getElementById('gantt-chart');
    const resultSection = document.getElementById('result-section');
    let activeTimeouts = [];
    let myChart = null;

    function createBlock(s, showImmediately) {
        const b = document.createElement('div');
        b.className = 'gantt-block' + (s.Process === 'IDLE' ? ' idle' : '') + (showImmediately ? ' show' : '');
        b.style.width = (s.Duration * 25 + 40) + 'px';
        let label = s.Process === 'IDLE' ? 'Trống' : s.Process;
        b.innerHTML = `<span>${label}</span><span class="gantt-time">${s.Start} - ${s.End}</span>`;
        return b;
    }

    function playAnimation(speedMultiplier, btnElement) {
        document.querySelectorAll('.btn-speed').forEach(b => b.classList.remove('active'));
        if(btnElement) btnElement.classList.add('active');

        activeTimeouts.forEach(t => clearTimeout(t));
        activeTimeouts = [];
        ganttContainer.innerHTML = '';
        resultSection.style.display = 'none';
        resultSection.style.opacity = '0';
        document.getElementById('guide-section').style.display = 'none';

        if(speedMultiplier === 0) {
            steps.forEach(s => ganttContainer.appendChild(createBlock(s, true)));
            finishRender();
            return;
        }

        let delay = 0;
        const baseDelay = 800 * speedMultiplier;
        steps.forEach((s, i) => {
            let t = setTimeout(() => {
                let block = createBlock(s, false);
                ganttContainer.appendChild(block);
                setTimeout(() => block.classList.add('show'), 20);
                if(i === steps.length - 1) setTimeout(finishRender, baseDelay);
            }, delay);
            activeTimeouts.push(t);
            delay += baseDelay;
        });
    }

    function finishRender() {
        resultSection.style.display = 'block';
        setTimeout(() => {
            resultSection.style.opacity = '1';
            renderChart();
            window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        }, 100);
    }

    // Logic 4: Vẽ biểu đồ Chart.js tự động nhận diện Sáng/Tối
    function renderChart() {
        const ctx = document.getElementById('performanceChart').getContext('2d');
        if(myChart) myChart.destroy();

        // Kiểm tra xem web đang ở Sáng hay Tối để chọn màu chữ biểu đồ cho nét
        const isDark = document.body.classList.contains('dark-mode');
        const gridColor = isDark ? '#333333' : '#e0e0e0';
        const textColor = isDark ? '#aaaaaa' : '#495057';
        const wtColor = isDark ? '#555555' : '#888888';

        myChart = new Chart(ctx, {
            type: 'bar',
            data: {
                labels: labels,
                datasets: [
                    { label: 'Waiting Time (ms)', data: wtData, backgroundColor: wtColor, borderRadius: 4 },
                    { label: 'Turnaround Time (ms)', data: tatData, backgroundColor: '#c2185b', borderRadius: 4 } // Lấy màu đỏ mận cơ bản
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                scales: {
                    y: { beginAtZero: true, grid: { color: gridColor }, ticks: { color: textColor } },
                    x: { grid: { display: false }, ticks: { color: textColor, font: { weight: 'bold' } } }
                },
                plugins: {
                    legend: { labels: { color: textColor, font: { family: 'Inter', size: 13, weight: 'bold' } } }
                }
            }
        });
    }

    function toggleGuide() {
        const g = document.getElementById('guide-section');
        const c = document.getElementById('guide-steps-container');
        if(g.style.display === 'block') {
            g.style.display = 'none';
            return;
        }

        if(c.innerHTML.trim() === '') {
            c.innerHTML = steps.map(s => {
                let desc = s.Process === 'IDLE'
                    ? `<span style="color:var(--text-muted);">CPU rảnh rỗi (Không có tiến trình trong hàng đợi).</span>`
                    : `Cấp CPU cho <span class="guide-highlight red">${s.Process}</span> chạy trong ${s.Duration}ms.`;
                return `<div class="guide-step">Tại mốc <span class="guide-highlight">${s.Start}ms</span>: ${desc} (Kết thúc lúc ${s.End}ms)</div>`;
            }).join('');
        }

        g.style.display = 'block';
        setTimeout(() => g.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
    }

    // Logic 6: Chụp ảnh thông minh theo Giao diện
    function captureScreen() {
        const isDark = document.body.classList.contains('dark-mode');
        const swalBg = isDark ? '#151515' : '#ffffff';
        const swalColor = isDark ? '#ffffff' : '#212529';
        const canvasBg = isDark ? '#0a0a0a' : '#f8f9fa'; // Chụp nền đen hay nền xám trắng

        Swal.fire({
            title: 'Đang xử lý ảnh...',
            text: 'Vui lòng chờ hệ thống xuất file chất lượng cao',
            background: swalBg, color: swalColor,
            allowOutsideClick: false,
            didOpen: () => Swal.showLoading()
        });

        html2canvas(document.getElementById('capture-area'), {
            backgroundColor: canvasBg, scale: 2
        }).then(canvas => {
            Swal.close();
            const link = document.createElement('a');
            link.download = 'PhanTich_RoundRobin.png';
            link.href = canvas.toDataURL("image/png");
            link.click();
            Swal.fire({ icon: 'success', title: 'Hoàn tất!', text: 'Ảnh đã lưu về máy.', background: swalBg, color: swalColor, confirmButtonColor: '#2ecc71' });
        });
    }

    // Nếu người dùng bấm đổi giao diện lúc đang ở trang kết quả, biểu đồ cần vẽ lại màu
    document.getElementById('themeBtn').addEventListener('click', () => {
        if (myChart != null) {
            setTimeout(renderChart, 100); // Đợi 1 tí cho class dark-mode áp dụng xong rồi vẽ lại
        }
    });

    window.onload = () => playAnimation(1, document.getElementById('btn-1x'));
</script>