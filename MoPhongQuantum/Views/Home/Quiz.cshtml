@{
    ViewData["Title"] = "Trắc Nghiệm Hệ Điều Hành";
}

<style>
    /* SỬ DỤNG BIẾN CSS ĐỂ ĐỒNG BỘ SÁNG/TỐI */
    .quiz-container {
        max-width: 800px;
        margin: 40px auto;
        background: var(--bg-card);
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 15px 35px var(--shadow-color);
        border-top: 4px solid var(--primary-red);
        transition: 0.4s ease;
    }

        .quiz-container h2 {
            color: var(--primary-red);
            text-align: center;
            text-transform: uppercase;
            letter-spacing: 2px;
            margin-bottom: 30px;
            font-weight: bold;
            font-size: 22px;
        }

    .question-block {
        background: var(--bg-main);
        padding: 25px;
        border-radius: 8px;
        margin-bottom: 25px;
        border-left: 3px solid var(--border-color);
        transition: 0.4s ease;
        border: 1px solid var(--border-color);
    }

    .question-title {
        color: var(--text-main);
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 15px;
        line-height: 1.5;
    }

    .option {
        display: block;
        padding: 14px 18px;
        margin-bottom: 10px;
        background: var(--bg-card);
        color: var(--text-muted);
        border-radius: 6px;
        cursor: pointer;
        transition: 0.2s;
        border: 1px solid var(--border-color);
        font-weight: 500;
        font-size: 14px;
    }

        .option:hover {
            border-color: var(--primary-red);
            color: var(--text-main);
        }

        .option input[type="radio"] {
            margin-right: 12px;
            accent-color: var(--primary-red);
            cursor: pointer;
            transform: scale(1.1);
        }

    /* Các class đổi màu khi chấm điểm */
    .correct-ans {
        background: rgba(46, 204, 113, 0.1) !important;
        border-color: #2ecc71 !important;
        color: #2ecc71 !important;
        font-weight: bold;
    }

    .wrong-ans {
        background: rgba(194, 24, 91, 0.1) !important;
        border-color: var(--primary-red) !important;
        color: var(--primary-red) !important;
        font-weight: bold;
    }

    .btn-submit {
        display: block;
        width: 100%;
        padding: 16px;
        background: var(--primary-red);
        color: white;
        border: none;
        border-radius: 6px;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
        text-transform: uppercase;
        margin-top: 30px;
        transition: 0.3s;
        letter-spacing: 1px;
    }

        .btn-submit:hover {
            filter: brightness(1.1);
            box-shadow: 0 5px 15px var(--shadow-color);
            transform: translateY(-2px);
        }

    #result-box {
        display: none;
        margin-top: 30px;
        text-align: center;
        padding: 35px;
        background: var(--bg-main);
        border-radius: 8px;
        border: 2px dashed var(--primary-red);
        transition: 0.4s ease;
    }

    #score-text {
        font-size: 20px;
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 15px;
        text-transform: uppercase;
    }

        #score-text span {
            color: var(--primary-red);
            font-size: 45px;
            font-weight: 800;
            display: block;
            margin-top: 10px;
        }

    .btn-retry {
        display: inline-block;
        padding: 14px 25px;
        background: transparent;
        border: 2px solid var(--primary-red);
        color: var(--primary-red);
        border-radius: 6px;
        font-weight: bold;
        cursor: pointer;
        transition: 0.3s;
        text-transform: uppercase;
        margin-top: 20px;
        font-size: 13px;
        letter-spacing: 1px;
    }

        .btn-retry:hover {
            background: var(--primary-red);
            color: #fff;
        }
</style>

<div class="quiz-container">
    <h2>Kiểm Tra Kiến Thức OS</h2>

    <div id="quiz-questions-container"></div>

    <button class="btn-submit" id="btn-submit" onclick="checkAnswers()">Nộp Bài & Chấm Điểm</button>

    <div id="result-box">
        <div id="score-text">Kết Quả Bài Làm <br /> <span>0 / 4</span></div>
        <p style="color: var(--text-muted); margin-bottom: 20px; font-size: 14px;">Vui lòng xem lại các câu bị đánh dấu đỏ ở phía trên!</p>
        <button class="btn-retry" onclick="loadRandomQuestions()">🔄 Làm Lại & Đổi Bộ Đề Khác</button>
    </div>
</div>

<script>
    // 1. NGÂN HÀNG 35 CÂU HỎI HỆ ĐIỀU HÀNH & LINUX
    const questionBank = [
        { q: "Lát cắt thời gian (Time Quantum) là tham số cốt lõi của thuật toán định thời nào?", opts: { A: "FCFS", B: "Round Robin (Phân phối xoay vòng)", C: "SJF" }, ans: "B" },
        { q: "Điều gì xảy ra nếu giá trị Time Quantum được thiết lập quá lớn (gần bằng vô cùng)?", opts: { A: "Thuật toán RR sẽ biến thành thuật toán FCFS", B: "Tốn thời gian Context Switch", C: "Hệ thống bị treo" }, ans: "A" },
        { q: "Ưu điểm lớn nhất của thuật toán Round Robin là gì?", opts: { A: "Thời gian chờ trung bình luôn nhỏ nhất", B: "Không có tiến trình nào bị 'bỏ đói', đảm bảo tính công bằng", C: "Sử dụng ít bộ nhớ nhất" }, ans: "B" },
        { q: "Thời gian chờ (Waiting Time) của một tiến trình được tính bằng công thức nào?", opts: { A: "Thời điểm hoàn thành - Thời điểm xuất hiện", B: "Thời gian lưu lại hệ thống (Turnaround Time) - Thời gian chạy (Burst Time)", C: "Burst Time - Time Quantum" }, ans: "B" },
        { q: "Trong Linux, hàm nào được sử dụng để nhân bản (tạo bản sao mới) của một tiến trình?", opts: { A: "system()", B: "exec()", C: "fork()" }, ans: "C" },
        { q: "Khi gọi hàm fork() thành công, giá trị trả về bên trong tiến trình con (child process) là bao nhiêu?", opts: { A: "0", B: "1", C: "PID của tiến trình cha" }, ans: "A" },
        { q: "Khi gọi hàm fork() thành công, giá trị trả về bên trong tiến trình cha (parent process) là bao nhiêu?", opts: { A: "0", B: "PID của tiến trình con vừa được tạo", C: "-1" }, ans: "B" },
        { q: "Nếu hàm fork() thất bại (không thể tạo tiến trình mới), nó sẽ trả về giá trị nào?", opts: { A: "0", B: "1", C: "-1" }, ans: "C" },
        { q: "Hàm wait() có vai trò gì khi tiến trình cha và con đang cùng hoạt động?", opts: { A: "Đưa tiến trình cha vào trạng thái ngủ", B: "Bắt tiến trình cha phải dừng lại chờ tiến trình con kết thúc", C: "Hủy bỏ tiến trình con ngay lập tức" }, ans: "B" },
        { q: "Các hàm exec() trong Linux có tác dụng gì?", opts: { A: "Thay thế toàn bộ ảnh của tiến trình hiện tại thành ảnh của tiến trình mới", B: "Tạo ra một tiến trình con chạy song song", C: "Tạm dừng tiến trình hiện tại" }, ans: "A" },
        { q: "Hàm system() khác gì so với các hàm exec()?", opts: { A: "system() gọi shell thực thi lệnh và chờ lệnh kết thúc mới quay về, không thay thế tiến trình", B: "system() chạy nhanh hơn exec()", C: "system() chỉ dùng được cho lệnh ls" }, ans: "A" },
        { q: "Macro nào được dùng cùng với hàm wait() để kiểm tra xem tiến trình con có kết thúc bình thường hay không?", opts: { A: "WEXITSTATUS", B: "WIFSIGNALED", C: "WIFEXITED" }, ans: "C" },
        { q: "Mỗi tiến trình trong Linux được cấp phát không gian địa chỉ bộ nhớ phẳng là bao nhiêu (trên hệ thống 32-bit)?", opts: { A: "2GB", B: "4GB", C: "8GB" }, ans: "B" },
        { q: "Tiến trình đầu tiên được khởi động cùng hệ điều hành Linux, có PID bằng 1 tên là gì?", opts: { A: "bash", B: "root", C: "init (hoặc systemd)" }, ans: "C" },
        { q: "PPID (Parent PID) là thông số mang ý nghĩa gì?", opts: { A: "Số định danh của tiến trình cha", B: "Thời gian chiếm dụng CPU của tiến trình", C: "Độ ưu tiên của tiến trình" }, ans: "A" },
        { q: "Lệnh nào được dùng để hiển thị thông tin chi tiết về các tiến trình đang chạy (PID, TTY, CMD...)?", opts: { A: "ps", B: "ls", C: "cat" }, ans: "A" },
        { q: "Phím tắt hoặc cú pháp nào dùng để tạm dừng một chương trình và đưa nó vào hoạt động phía hậu trường (background)?", opts: { A: "Ctrl + C", B: "Ctrl + Z hoặc thêm ký tự & cuối lệnh", C: "Ctrl + D" }, ans: "B" },
        { q: "Lệnh nào dùng để tạo ra một thư mục mới trong Linux?", opts: { A: "mkdir", B: "rmdir", C: "touch" }, ans: "A" },
        { q: "Lệnh nào dùng để sao chép tập tin hoặc thư mục?", opts: { A: "mv", B: "cp", C: "rm" }, ans: "B" },
        { q: "Để di chuyển hoặc đổi tên một tập tin, ta sử dụng lệnh nào?", opts: { A: "mv", B: "cp", C: "rn" }, ans: "A" },
        { q: "Lệnh rm dùng để xóa tập tin. Nếu muốn xóa một thư mục CÓ CHỨA dữ liệu bên trong, ta dùng cờ (flag) nào?", opts: { A: "rm -f", B: "rm -r", C: "rm -d" }, ans: "B" },
        { q: "Lệnh nào là một công cụ mạnh mẽ dùng để tìm kiếm một chuỗi ký tự bên trong tập tin văn bản?", opts: { A: "find", B: "locate", C: "grep" }, ans: "C" },
        { q: "Lệnh cat thường được sử dụng để làm gì?", opts: { A: "Xem nội dung của một tập tin văn bản ngắn", B: "Xem danh sách thư mục", C: "Xem dung lượng ổ đĩa" }, ans: "A" },
        { q: "Để đóng gói và nén các tập tin thành đuôi .tar, cú pháp cơ bản là gì?", opts: { A: "tar -xvf", B: "tar -cvf", C: "tar -z" }, ans: "B" },
        { q: "Đường dẫn tuyệt đối (Absolute Path) trong hệ thống tập tin Linux luôn bắt đầu bằng ký tự nào?", opts: { A: "~", B: "/", C: "." }, ans: "B" },
        { q: "Trình biên dịch mặc định phổ biến nhất dùng cho ngôn ngữ C/C++ trên Linux là gì?", opts: { A: "visual studio", B: "gcc", C: "javac" }, ans: "B" },
        { q: "Để trình biên dịch gcc chỉ tạo ra tập tin đối tượng (object file đuôi .o) mà chưa tạo file thực thi, ta dùng tùy chọn nào?", opts: { A: "-c", B: "-o", C: "-l" }, ans: "A" },
        { q: "Trong Linux, các tập tin thư viện liên kết tĩnh (static library) thường có phần mở rộng (đuôi) là gì?", opts: { A: ".so", B: ".dll", C: ".a" }, ans: "C" },
        { q: "Trong Linux, các tập tin thư viện liên kết động (dynamic library) thường có phần mở rộng (đuôi) là gì?", opts: { A: ".so", B: ".a", C: ".lib" }, ans: "A" },
        { q: "Lệnh nào được sử dụng để đóng gói nhiều file object (.o) thành một thư viện liên kết tĩnh (.a)?", opts: { A: "tar", B: "ar", C: "ld" }, ans: "B" },
        { q: "Khi biên dịch một chương trình C có sử dụng thư viện tự viết, tùy chọn nào chỉ định gcc tìm kiếm thư viện trong thư mục hiện tại?", opts: { A: "-L.", B: "-I.", C: "-c" }, ans: "A" },
        { q: "Để tạo thư viện liên kết động bằng gcc, ta bắt buộc phải sử dụng tùy chọn nào trong quá trình liên kết?", opts: { A: "-static", B: "-shared", C: "-dynamic" }, ans: "B" },
        { q: "Biến môi trường nào được Hệ Điều Hành dùng để tìm kiếm các thư viện liên kết động (.so) khi chương trình thực thi?", opts: { A: "PATH", B: "LD_LIBRARY_PATH", C: "INCLUDE_PATH" }, ans: "B" },
        { q: "Khi biên dịch code C thành object file để dùng cho thư viện liên kết động, ta phải thêm tùy chọn nào để tạo 'mã lệnh vị trí độc lập'?", opts: { A: "-fpic", B: "-c", C: "-o" }, ans: "A" },
        { q: "Lệnh ldd dùng để làm gì đối với một chương trình thực thi trên Linux?", opts: { A: "Xem mã nguồn C của chương trình", B: "Kiểm tra xem hệ điều hành có tìm ra tất cả thư viện động (.so) mà chương trình cần hay không", C: "Xóa chương trình khỏi bộ nhớ" }, ans: "B" }
    ];

    let currentQuestions = [];

    // 2. HÀM TẢI VÀ TRỘN CÂU HỎI
    function loadRandomQuestions() {
        document.getElementById("result-box").style.display = "none";
        document.getElementById("btn-submit").style.display = "block";

        // Trộn ngẫu nhiên và lấy 4 câu
        let shuffled = [...questionBank].sort(() => 0.5 - Math.random());
        currentQuestions = shuffled.slice(0, 4);

        const container = document.getElementById("quiz-questions-container");
        container.innerHTML = "";

        currentQuestions.forEach((item, index) => {
            let html = `
                <div class="question-block" id="q${index}-block">
                    <div class="question-title">Câu ${index + 1}: ${item.q}</div>
                    <label class="option"><input type="radio" name="q${index}" value="A"> A. ${item.opts.A}</label>
                    <label class="option"><input type="radio" name="q${index}" value="B"> B. ${item.opts.B}</label>
                    <label class="option"><input type="radio" name="q${index}" value="C"> C. ${item.opts.C}</label>
                </div>
            `;
            container.innerHTML += html;
        });

        window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // 3. HÀM CHẤM ĐIỂM
    function checkAnswers() {
        let score = 0;

        currentQuestions.forEach((item, index) => {
            let qName = "q" + index;
            let selected = document.querySelector(`input[name="${qName}"]:checked`);
            let block = document.getElementById(`${qName}-block`);
            let options = block.querySelectorAll('.option');

            // Xóa màu cũ
            options.forEach(opt => { opt.classList.remove('correct-ans', 'wrong-ans'); });

            if (selected) {
                if (selected.value === item.ans) {
                    score++;
                    selected.parentElement.classList.add('correct-ans');
                    block.style.borderLeftColor = "#2ecc71";
                } else {
                    selected.parentElement.classList.add('wrong-ans');
                    block.style.borderLeftColor = "var(--primary-red)";

                    options.forEach(opt => {
                        if(opt.querySelector('input').value === item.ans) {
                            opt.classList.add('correct-ans');
                        }
                    });
                }
            } else {
                block.style.borderLeftColor = "var(--primary-red)";
            }

            // Vô hiệu hóa nút chọn sau khi đã chấm
            let radios = block.querySelectorAll(`input[type="radio"]`);
            radios.forEach(radio => radio.disabled = true);
        });

        // Hiện điểm
        let resultBox = document.getElementById("result-box");
        document.querySelector("#score-text span").innerText = score + " / 4";
        resultBox.style.display = "block";
        document.getElementById("btn-submit").style.display = "none";

        window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
    }

    // Chạy ngay khi vào web
    window.onload = loadRandomQuestions;
</script>